# Variáveis opcionais do SMA de Controladoria. Copie para `.env` e preencha só o que for usar.
# Aqui ficam apenas os NOMES: nenhum valor real deve ser versionado.
# O LLM é opcional e vem desligado; sem estas chaves o sistema funciona inteiro, offline.

# Claude (provedor `anthropic`; exige o extra: pip install "fin-mas[llm]")
ANTHROPIC_API_KEY=

# GPT (provedor `openai`)
OPENAI_API_KEY=

# Gemini (provedor `gemini`)
GEMINI_API_KEY=

# Servidor compatível com a API da OpenAI (provedor `openai-compat`, ex.: modelo local). Opcional.
FIN_MAS_LLM_API_KEY=

# Onde ficam as chaves de integridade (trace, memória, cadastro de acesso). Padrão: ~/.fin_mas
FIN_MAS_DIR_CHAVES=

# ---- Implantação (DSM4, docs/dsm4/implantacao.md); lidas pelo contêiner (docker/entrada.sh) ----
# Senha do administrador criado na primeira subida (12+ caracteres). Tire-a daqui depois que subir.
FIN_MAS_SENHA_NOVA=
# Usuário do administrador (padrão: admin)
FIN_MAS_ADMIN=
# 1 = contas de demonstração com senha pública (só para avaliação), em vez do administrador acima
FIN_MAS_DEMO=
# Porte (mei, micro, pequena, media, media_ii, grande), segmento (software_servicos, comercio, servicos,
# industria) e cognição (basico, local, llm) da instalação; só valem na primeira subida
FIN_MAS_PORTE=
FIN_MAS_SEGMENTO=
FIN_MAS_COGNICAO=
# URLs para as quais uma chave de LLM pode ser enviada além da URL padrão de cada provedor
# (separadas por vírgula; ex.: servidor local compatível com a OpenAI)
FIN_MAS_LLM_URLS_CONFIAVEIS=
