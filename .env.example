# Variáveis opcionais do SMA de Controladoria. Copie para `.env` e preencha só o que for usar.
# Aqui ficam apenas os NOMES: nenhum valor real deve ser versionado.
# O LLM é opcional e vem desligado; sem estas chaves o sistema funciona inteiro, offline.

# Claude (provedor `anthropic`; exige o extra: pip install "fin-mas[llm]")
ANTHROPIC_API_KEY=

# GPT (provedor `openai`)
OPENAI_API_KEY=

# Gemini (provedor `gemini`)
GEMINI_API_KEY=

# Servidor compatível com a API da OpenAI (provedor `openai-compat`, ex.: modelo local). Opcional.
FIN_MAS_LLM_API_KEY=

# Onde ficam as chaves de integridade (trace, memória, cadastro de acesso). Padrão: ~/.fin_mas
FIN_MAS_DIR_CHAVES=

# URLs (separadas por vírgula) que podem receber a chave de API do servidor além da URL padrão de cada provedor.
# Fora desta lista, uma base_url configurada pelo dashboard nunca recebe a chave.
# FIN_MAS_LLM_URLS_CONFIAVEIS=
